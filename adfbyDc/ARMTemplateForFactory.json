							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "select count(*) as total_rows from @{pipeline().parameters.schema}.@{pipeline().parameters.table} WHERE last_updated> '@{if(empty(pipeline().parameters.backdate),activity('last_cdc').output.value[0].cdc_timestamp,pipeline().parameters.backdate)}'",
